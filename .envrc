# Project env for 0xide. Build needs nothing special today — Smithay's system
# libraries come from the flake and the toolchain is pinned by
# rust-toolchain.toml.

export RUST_BACKTRACE=1

# Per-scenario vars stay on the command line, NOT here (they change what a
# plain run does): WLR_BACKENDS=headless, WLR_WL_OUTPUTS=2, OXIDE_MOD=alt,
# OXIDE_CONFIG=..., WLR_DRM_DEVICES=/dev/dri/cardN.
export TOP_HEAD="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"

# Before `use flake`: it exports NVIDIA_VERSION from /proc/driver/nvidia/version,
# which the flake reads through builtins.getEnv (hence --impure) to build the
# nixGL wrappers. Loading the flake first is what made it throw.
use nvidia
# unset BACKEND RUN_WITH WL_SOCKET
use display
export RUN_WITH=nixLavapipe

use flake --impure --option warn-dirty false

export PATH="$PATH:$PWD/target/debug:$PWD/target/release"

export_alias _b "cd $TOP_HEAD && make build; cd -"
export_alias _c "cd $TOP_HEAD && make compile; cd -"
export_alias _r "cd $TOP_HEAD && make run; cd -"
export_alias _t "cd $TOP_HEAD && make test; cd -"
